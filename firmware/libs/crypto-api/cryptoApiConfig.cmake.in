@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(signedImageFormat REQUIRED)
find_dependency(OpenSSL REQUIRED COMPONENTS Crypto SSL)

include(${CMAKE_CURRENT_LIST_DIR}/cryptoApiTargets.cmake)
check_required_components(cryptoApi)