set -xe

##############
#Sign Images
##############

# SP BL1
@SIGN_TOOLS_DIR@/esperanto_sign_elf -N SP_BL1 \
 @CMAKE_CURRENT_BINARY_DIR@/signed_bl1.img \
 @SP_BL1_ELF@ \
 /dev/null \
 /dev/null \
 SHA2-256 0

# SP BL2
@SIGN_TOOLS_DIR@/esperanto_sign_elf -N SP_BL2 \
 @CMAKE_CURRENT_BINARY_DIR@/signed_bl2.img \
 @SP_BL2_PROD_ELF@ \
 /dev/null \
 /dev/null \
 SHA2-256 0

# SP BL2 TF
@SIGN_TOOLS_DIR@/esperanto_sign_elf -N SP_BL2 \
 @CMAKE_CURRENT_BINARY_DIR@/signed_bl2_tf.img \
 @SP_BL2_TF_ELF@ \
 /dev/null \
 /dev/null \
 SHA2-256 0


# SP BL2 LINUX-MODE
@SIGN_TOOLS_DIR@/esperanto_sign_elf -N SP_BL2 \
 @CMAKE_CURRENT_BINARY_DIR@/signed_bl2_linux.img \
 @SP_BL2_LINUX_ELF@ \
 /dev/null \
 /dev/null \
 SHA2-256 0



# Various PCIE Boot Configurations

# Sign PCI-E Boot config Link Tranining Bypass
@SIGN_TOOLS_DIR@/esperanto_sign_raw -N PCIE_PHY_FW \
 @CMAKE_CURRENT_BINARY_DIR@/signed_pcie_config_bypass_link_train.img \
 @PCIE_BOOT_CONFIG_DIR@/pcie_config_bypass_link_train.bin \
 /dev/null \
 /dev/null \
 SHA2-256 0 0 0 00000000000000000000000000000000

# Sign PCI-E config default PHY FW first established speed
@SIGN_TOOLS_DIR@/esperanto_sign_raw -N PCIE_PHY_FW \
 @CMAKE_CURRENT_BINARY_DIR@/signed_pcie_config_def_phy_fw_any_speed.img \
 @PCIE_BOOT_CONFIG_DIR@/pcie_config_def_phy_fw_any_speed.bin \
 /dev/null \
 /dev/null \
 SHA2-256 0 0 0 00000000000000000000000000000000

# Sign PCI-E config default PHY FW Gen 4
@SIGN_TOOLS_DIR@/esperanto_sign_raw -N PCIE_PHY_FW \
 @CMAKE_CURRENT_BINARY_DIR@/signed_pcie_config_def_phy_fw_gen4.img \
 @PCIE_BOOT_CONFIG_DIR@/pcie_config_def_phy_fw_gen4.bin \
 /dev/null \
 /dev/null \
 SHA2-256 0 0 0 00000000000000000000000000000000

# Sign PCI-E config Phy FW override
@SIGN_TOOLS_DIR@/esperanto_sign_raw -N PCIE_PHY_FW \
 @CMAKE_CURRENT_BINARY_DIR@/signed_pcie_config_override_phy_fw.img \
 @PCIE_BOOT_CONFIG_DIR@/pcie_config_override_phy_fw.bin \
 /dev/null \
 /dev/null \
 SHA2-256 0 0 0 00000000000000000000000000000000

