# Hacked up debug build Makefile (based on the one generated by the Atmel Studio Windows
# IDE) for prototyping a pcie3 bootloader linux build.  This will eventually be replaced
# with the standard build process (cmake, etc).

TARGET = bootloader

# target source code info
SRCS = src/main.c \
       src/startup_samd20.c \
       src/system_init.c \
       src/gpio.c \
       src/nvm.c \
       ../common/Config/src/config.c \
       ../common/Utils/src/flash_access.c \
       ../common/Utils/src/image_checksum.c \
       ../common/Utils/src/hw_encoding.c
VPATH = ../common/Config/src:../common/Utils/src:.:src

# target-specific build flags
CFLAGS = -DBOOTLOADER -Wpacked \
         -I"./inc" \
         -I"." \
         -I"../common/Config/inc" \
         -I"../common/System/inc" \
         -I"../common/Utils/inc" \
         -I"../common/ThirdParty/asf3/sam0/utils" \
         -I"../common/ThirdParty/asf3/sam0/utils/preprocessor" \
         -I"../common/ThirdParty/asf3/sam0/utils/header_files" \
         -I"../common/ThirdParty/asf3/sam0/utils/cmsis/samd20/include" \
         -I"../common/ThirdParty/asf3/sam0/utils/cmsis/samd20/source" \
         -I"../common/ThirdParty/asf3/common/utils" \
         -I"../common/ThirdParty/asf3/thirdparty/CMSIS/Include"
LDFLAGS = -nodefaultlibs -nostdlib

# common settings
LINKER_SCRIPT_DIR = ../common/Linker/
LINKER_SCRIPT = $(LINKER_SCRIPT_DIR)/bootloader.ld

COMMITID = $(shell git log | head -1 | cut -b8-)
ifneq ($(shell git diff), )
COMMITID := $(COMMITID)-dirty
endif
CFLAGS += -DCOMMITID='"$(COMMITID)"'

include ../Makefile.inc
