#Hacked up debug build Makefile(based on the one generated by the Atmel Studio Windows
#IDE) for prototyping a linux build.This will eventually be replaced with the
#standard build process(cmake, etc).

TARGET = runtime

ifndef SLOT_IMAGE
$(error SLOT_IMAGE environment variable must be defined)
endif

COMMON_DIR=../common
CONFIG_DIR=$(COMMON_DIR)/Config
SYSTEM_DIR=$(COMMON_DIR)/System
UTILS_DIR=$(COMMON_DIR)/Utils
HW_PLATFORM_DIR=$(COMMON_DIR)/HardwarePlatform
DRIVERS_DIR=$(HW_PLATFORM_DIR)/Drivers
BOARD_SPECIFIC_DIR=$(DRIVERS_DIR)/BoardSpecific
APP_CLI_DIR=./CLI
APP_ETSOC_CMD_DIR=./ETSOCCommandHandler
APP_UPDATE_MNGR_DIR=./FirmwareUpdateManager
APP_PWR_MNGR_DIR=./PowerManager
APP_STARTUP_DIR=./Startup
THIRD_PARTY_DIR=$(COMMON_DIR)/ThirdParty

#target source code info
SRCS = $(wildcard $(CONFIG_DIR)/src/*.c $(SYSTEM_DIR)/src/*.c $(UTILS_DIR)/src/*.c $(DRIVERS_DIR)/src/*.c $(BOARD_SPECIFIC_DIR)/src/*.c \
       $(APP_CLI_DIR)/src/*.c  $(APP_ETSOC_CMD_DIR)/src/*.c  $(APP_UPDATE_MNGR_DIR)/src/*.c  $(APP_PWR_MNGR_DIR)/src/*.c $(APP_STARTUP_DIR)/src/*.c) \
       $(THIRD_PARTY_DIR)/FreeRTOSv10.3.1/FreeRTOS/Source/list.c \
       $(THIRD_PARTY_DIR)/FreeRTOSv10.3.1/FreeRTOS/Source/queue.c \
       $(THIRD_PARTY_DIR)/FreeRTOSv10.3.1/FreeRTOS/Source/stream_buffer.c \
       $(THIRD_PARTY_DIR)/FreeRTOSv10.3.1/FreeRTOS/Source/tasks.c \
       $(THIRD_PARTY_DIR)/FreeRTOSv10.3.1/FreeRTOS/Source/portable/GCC/ARM_CM0/port.c

VPATH = $(APP_CLI_DIR)/src:$(APP_ETSOC_CMD_DIR)/src:$(APP_UPDATE_MNGR_DIR)/src:$(APP_PWR_MNGR_DIR)/src:$(APP_STARTUP_DIR)/src:$(DRIVERS_DIR)/src:$(BOARD_SPECIFIC_DIR)/src:$(CONFIG_DIR)/src:$(SYSTEM_DIR)/src:$(UTILS_DIR)/src:$(THIRD_PARTY_DIR)/FreeRTOSv10.3.1/FreeRTOS/Source:$(THIRD_PARTY_DIR)/FreeRTOSv10.3.1/FreeRTOS/Source/portable/GCC/ARM_CM0:.

# target-specific flags
CFLAGS = -Wvolatile-register-var -Wno-attributes -Wno-packed -ffunction-sections \
         -I"." \
         -I"./inc" \
         -I"$(DRIVERS_DIR)/inc" \
         -I"$(DRIVERS_DIR)/chips" \
         -I"$(BOARD_SPECIFIC_DIR)/inc" \
         -I"$(CONFIG_DIR)/inc" \
         -I"$(SYSTEM_DIR)/inc" \
         -I"$(UTILS_DIR)/inc" \
         -I"$(HW_PLATFORM_DIR)/inc" \
         -I"$(APP_CLI_DIR)/inc" \
         -I"$(APP_ETSOC_CMD_DIR)/inc" \
         -I"$(APP_UPDATE_MNGR_DIR)/inc" \
         -I"$(APP_PWR_MNGR_DIR)/inc" \
         -I"$(APP_STARTUP_DIR)/inc" \
         -I"$(THIRD_PARTY_DIR)/asf3/sam0/utils" \
         -I"$(THIRD_PARTY_DIR)/asf3/sam0/utils/preprocessor" \
         -I"$(THIRD_PARTY_DIR)/asf3/sam0/utils/header_files" \
         -I"$(THIRD_PARTY_DIR)/asf3/sam0/utils/cmsis/samd20/include" \
         -I"$(THIRD_PARTY_DIR)/asf3/sam0/utils/cmsis/samd20/source" \
         -I"$(THIRD_PARTY_DIR)/asf3/common/utils" \
         -I"$(THIRD_PARTY_DIR)/asf3/thirdparty/CMSIS/Include" \
         -I"$(THIRD_PARTY_DIR)/FreeRTOSv10.3.1/FreeRTOS/Source/include" \
         -I"$(THIRD_PARTY_DIR)/FreeRTOSv10.3.1/FreeRTOS/Source/portable/GCC/ARM_CM0" \
         -I"$(THIRD_PARTY_DIR)/FreeRTOSv10.3.1/FreeRTOSConfig"

# common settings
LINKER_SCRIPT_DIR = $(COMMON_DIR)/Linker
ifeq ($(SLOT_IMAGE), 2)
LINKER_SCRIPT = $(LINKER_SCRIPT_DIR)/standalone_runtime.ld
else
LINKER_SCRIPT = $(LINKER_SCRIPT_DIR)/runtime.ld
endif
include ../Makefile.inc

BUILDTIME = $(shell date)
BUILDID = $(shell whoami)
COMMITID = $(shell git log | head -1 | cut -b8-)
COMMITID_SHORT = $(shell git log | head -1 | cut -c8-15)
LASTCOMMIT_DATE = $(shell git log -1 --format=%cd)
BRANCH = $(shell git branch | sed -n -e 's/^\* \(.*\)/\1/p')
COMMITMSG = $(shell git log -1 --pretty=%B | sed "s/\"/\\\\\"/g")
ifneq ($(shell git diff), )
UNCOMMITTED_CHANGES = 1
COMMITID := $(COMMITID)-dirty
COMMITID_SHORT := $(COMMITID_SHORT)-dirty
else
UNCOMMITTED_CHANGES = 0
endif

ifeq ($(BUILD_TYPE), Debug)
BUILD_TYPE_CODE = 0
else
ifeq ($(BUILD_TYPE), Release)
BUILD_TYPE_CODE = 1
else
$(error BUILD_TYPE must be either Debug or Release)
endif
endif

CFLAGS += -DBOOT_IMAGE_SLOT=$(SLOT_IMAGE)
CFLAGS += -DBUILDTIME='"$(BUILDTIME)"'
CFLAGS += -DBUILDID='"$(BUILDID)"'
CFLAGS += -DCOMMITID='"$(COMMITID)"'
CFLAGS += -DCOMMITID_SHORT='"$(COMMITID_SHORT)"'
CFLAGS += -DLASTCOMMIT_DATE='"$(LASTCOMMIT_DATE)"'
CFLAGS += -DBRANCH='"$(BRANCH)"'
CFLAGS += -DCOMMITMSG='"$(COMMITMSG)"'
CFLAGS += -DUNCOMMITTED_CHANGES=$(UNCOMMITTED_CHANGES)
CFLAGS += -DBUILD_TYPE=$(BUILD_TYPE_CODE)

